{
  "name": "@dcmjs/commands",
  "version": "0.1.0",
  "description": "Command line tools for dcmjs and DICOMweb",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "DCMJS",
    "DICOM",
    "DICOMweb"
  ],
  "author": "Bill Wallace <bill.wallace@radicalimaging.com>",
  "contributors": [
    "Bill Wallace <bill.wallace@radicalimaging.com>",
    "Abigail Watson <awatson1978@gmail.com>"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/awatson1978/dcmjs-commands"
  },
  "homepage": "https://github.com/awatson1978/dcmjs-commands#readme",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "bin": {
    "dcmjs": "bin/dcmjs.js",
    "dicomwebjs": "bin/dicomwebjs.js",
    "dimsejs": "bin/dimsejs.js",
    "dcmjs-mcp": "bin/dcmjs-mcp.js"
  },
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "lint": "eslint \"{src,bin,test}/**/*.{js,mjs}\"",
    "lint:fix": "eslint --fix \"{src,bin,test}/**/*.{js,mjs}\"",
    "format": "prettier --write \"{src,bin,test}/**/*.js\"",
    "format:check": "prettier --check \"{src,bin,test}/**/*.js\""
  },
  "jest": {
    "verbose": true,
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "**/test/**/*.test.js"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^12.1.0",
    "dcmjs": "file:../dcmjs-integration",
    "dicomweb-client": "^0.11.2",
    "jpeg-js": "^0.4.4",
    "jsdom": "^29.1.1",
    "loglevel": "^1.9.2",
    "pngjs": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.2"
  }
}
